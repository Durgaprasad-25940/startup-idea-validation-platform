						{
							"listen": "test",
							"script": {
								"exec": [
									"// Automatically save the JWT token to a global environment variable\nvar jsonData = pm.response.json();\nif (jsonData.token) {\n    pm.globals.set(\"jwt_token\", jsonData.token);\n}"
