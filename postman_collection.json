							"path": [ "api", "reports" ]
						}
					}
				}
			]
		},
		{
			"name": "5. Admin Management",
			"item": [
				{
					"name": "Platform Statistics",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/admin/stats",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "admin", "stats" ]
						}
					}
				},
				{
					"name": "List All Platform Users",
					"request": {
