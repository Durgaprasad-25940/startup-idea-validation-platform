						"url": {
							"raw": "{{baseUrl}}/api/admin/users",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "admin", "users" ]
						}
					}
				},
				{
					"name": "List All Platform Ideas",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/admin/ideas",
							"host": [ "{{baseUrl}}" ],
